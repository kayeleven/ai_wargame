LM_ENVIRONMENT=development
LM_DATABASE_URL=postgresql+psycopg://living_memory:local-development-only@127.0.0.1:5432/living_memory_dev
# Generate a personal value with: python3.12 -c "import secrets; print(secrets.token_urlsafe(48))"
LM_SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
LM_SECURE_COOKIES=false
LM_SESSION_IDLE_MINUTES=30
LM_SESSION_ABSOLUTE_DAYS=7
LM_LOGIN_USERNAME_LIMIT=8
LM_LOGIN_SOURCE_LIMIT=80
LM_LOGIN_WINDOW_MINUTES=15
